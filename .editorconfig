# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# All files
[*]
charset = utf-8
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# TypeScript/JavaScript
[*.{ts,tsx,js,jsx}]
indent_size = 2

# HTML
[*.html]
indent_size = 2

# SCSS
[*.scss]
indent_size = 2

# C# files
[*.cs]
indent_size = 4

# JSON
[*.json]
indent_size = 2

# XML
[*.xml]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false
