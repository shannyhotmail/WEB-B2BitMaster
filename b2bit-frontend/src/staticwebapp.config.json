{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/*.css",
      "/*.js",
      "/*.png",
      "/*.jpg",
      "/*.svg"
    ]
  },
  "mimeTypes": {
    ".mp4": "video/mp4",
    ".pdf": "application/pdf"
  },
  "routes": [
    {
      "route": "/assets/guias/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow",
        "Content-Type": "application/pdf"
      }
    },
    {
      "route": "/g/*",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    }
  ]
}
